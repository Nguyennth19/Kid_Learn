{
  "name": "kidlearn-clean-rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:dry-run": "node scripts/setup-firestore.mjs",
    "test:rules": "firebase emulators:exec --project kidlearn-rules-test --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore,hosting",
    "firebase:use:dev": "firebase use dev"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.17.0",
    "firebase-tools": "^14.0.0"
  }
}
